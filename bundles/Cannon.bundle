                value: 40
                defaultValue: 12
              - name: range
                displayName: Range
                type: Float
                value: 12.5
                defaultValue: 14
              - name: reload
                displayName: Reload
                type: Float
                value: 1.9
                defaultValue: 1
              - name: shotSpeed
                displayName: Shot Speed
                type: Float
                value: 26
                defaultValue: 40
              - name: arc
                displayName: Shot Arc
                type: Float
                value: 5
                defaultValue: 0
