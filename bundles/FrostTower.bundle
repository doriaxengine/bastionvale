        normalMatrix: [[1, 0, 0, 3], [0, 1, 0, -3], [0, 0, 1, -26], [0, 0, 0, 1]]
        visible: true
        billboardRotation: [1, 0, 0, 0]
        billboard: false
        fakeBillboard: false
        cylindricalBillboard: false
      script:
        scripts:
          - type: lua
            path: scripts/Tower.lua
            className: Tower
            enabled: true
            properties:
              - name: damage
                displayName: Damage
                type: Float
                value: 6
                defaultValue: 12
              - name: range
                displayName: Range
                type: Float
                value: 11.5
                defaultValue: 14
              - name: reload
                displayName: Reload
                type: Float
                value: 0.55
                defaultValue: 1
              - name: shotSpeed
                displayName: Shot Speed
                type: Float
                value: 60
                defaultValue: 40
              - name: arc
                displayName: Shot Arc
                type: Float
                value: 0
                defaultValue: 0
              - name: splash
                displayName: Splash Radius
                type: Float
                value: 0
                defaultValue: 0
              - name: slow
                displayName: Slow
                type: Float
                value: 0.45
                defaultValue: 0
              - name: slowTime
                displayName: Slow Time
                type: Float
                value: 1.8
                defaultValue: 0
              - name: storyHeight
                displayName: Story Height
                type: Float
                value: 2.4
                defaultValue: 2.4
              - name: middle
                displayName: Middle
                type: EntityReference
                ptrTypeName: Object
                value: 1004
                defaultValue: 0
              - name: upper
                displayName: Upper
                type: EntityReference
                ptrTypeName: Object
                value: 1003
                defaultValue: 0
              - name: top
                displayName: Top
                type: EntityReference
                ptrTypeName: Object
                value: 1013
                defaultValue: 0
              - name: head
                displayName: Head
                type: EntityReference
                ptrTypeName: Object
                value: 1015
                defaultValue: 0
              - name: shot
                displayName: Shot
                type: EntityReference
                ptrTypeName: Object
                value: 1002
                defaultValue: 0
              - name: muzzle
                displayName: Muzzle
                type: EntityReference
                ptrTypeName: Particles
                value: 1022
                defaultValue: 0
              - name: impact
                displayName: Impact
                type: EntityReference
                ptrTypeName: Object
                value: 1020
                defaultValue: 0
              - name: impactParticles
                displayName: Impact Particles
                type: EntityReference
                ptrTypeName: Particles
                value: 1023
                defaultValue: 0
              - name: fireSound
                displayName: Fire Sound
                type: EntityReference
                ptrTypeName: Sound
                value: 1021
                defaultValue: 0
