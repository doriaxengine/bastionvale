        type: linear
        color: [0.6739, 0.7293, 0.8689]
        density: 0.01
        linearStart: 100
        linearEnd: 280
  - type: Entity
    entity: 1116
    name: Emitter
    components:
      action:
        state: Stopped
        speed: 1
        startOffset: 0
        randomStart: false
        target: 1115
        ownedTarget: false
      particles:
        maxParticles: 90
        emitter: true
        loop: true
        localSpace: false
        rate: 34
        maxPerUpdate: 64
        bursts: ~
        lifeInitializer:
          minLife: 1.1
          maxLife: 1.9
        positionInitializer:
          shape: Circle
          minPosition: [0, 0, 0]
          maxPosition: [0, 0, 0]
          radius: 3.2
          innerRadius: 1.8
          coneAngle: 45
          coneHeight: 1
        positionModifier:
          fromTime: 0
          toTime: 0
          fromPosition: [0, 0, 0]
          toPosition: [0, 0, 0]
          function: LINEAR
        velocityInitializer:
          minVelocity: [-0.4, 4, -0.4]
          maxVelocity: [0.4, 7.5, 0.4]
        velocityModifier:
          fromTime: 0
          toTime: 0
          fromVelocity: [0, 0, 0]
          toVelocity: [0, 0, 0]
          function: LINEAR
        accelerationInitializer:
          minAcceleration: [0, -1.2, 0]
          maxAcceleration: [0, -0.4, 0]
        accelerationModifier:
          fromTime: 0
          toTime: 0
          fromAcceleration: [0, 0, 0]
          toAcceleration: [0, 0, 0]
          function: LINEAR
        colorInitializer:
          minColor: [1, 1, 1]
          maxColor: [1, 1, 1]
          useSRGB: true
        colorModifier:
          fromTime: 0
          toTime: 0
          fromColor: [0, 0, 0]
          toColor: [0, 0, 0]
          function: LINEAR
          useSRGB: true
        colorGradient:
          useSRGB: true
          stops:
            - time: 0
              color: [0.55, 0.95, 1]
            - time: 0.6
              color: [0.35, 0.55, 1]
            - time: 1
              color: [0.2, 0.2, 0.55]
        alphaInitializer:
          minAlpha: 1
          maxAlpha: 1
        alphaModifier:
          fromTime: 0.44
          toTime: 1.9
          fromAlpha: 1
          toAlpha: 0
          function: LINEAR
        sizeInitializer:
          minSize: 1.6
          maxSize: 3
        sizeModifier:
          fromTime: 0
          toTime: 1.9
          fromSize: 3
          toSize: 0.75
          function: QUAD_OUT
        spriteInitializer:
          frames: ~
        spriteModifier:
          fromTime: 0
          toTime: 0
          function: LINEAR
          frames: ~
        rotationInitializer:
          minRotation: [1, 0, 0, 0]
          maxRotation: [1, 0, 0, 0]
          shortestPath: false
        rotationModifier:
          fromTime: 0
          toTime: 0
          fromRotation: [1, 0, 0, 0]
          toRotation: [1, 0, 0, 0]
          function: LINEAR
          shortestPath: false
        scaleInitializer:
          minScale: [1, 1, 1]
          maxScale: [1, 1, 1]
          linearSort: true
        scaleModifier:
          fromTime: 0
          toTime: 0
          fromScale: [1, 1, 1]
          toScale: [1, 1, 1]
